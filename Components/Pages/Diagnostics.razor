        try 
        {
            var (key, details) = ConfigService.GetSubscriptionForService("data factory v2", "az-amer-prod-sdmp-rg");
            
            if (details != null) 
            {
                var isCorrect = details.SubscriptionId == "e884a250-7177-4a12-9397-4032aa0f8070";
                testResult = $"ADF Routing: {(isCorrect ? "[CORRECT]" : "[WRONG]")}\n" +
                           $"Mapped to: {key} ({details.Name})\n" +
                           $"Subscription: {details.SubscriptionId}\n" +
                           $"Expected: e884a250-7177-4a12-9397-4032aa0f8070";
                           
                if (!isCorrect)
                {
                    if (details.SubscriptionId == "e4e37c2d-09d5-4584-9b5b-e4d389d8cd1b")
                        testResult += "\n[ERROR] Routing to NonProduction instead of Production";
                    else if (details.SubscriptionId == "35166c0d-3c12-4f4c-8638-79d7248ae93f")  
                        testResult += "\n[ERROR] Routing to Default instead of Production";
                    else
                        testResult += "\n[ERROR] Routing to unknown subscription";
                }
            }
            else 
            {
                testResult = "[ERROR] No subscription found for ADF routing test";
            }
        }
        catch (Exception ex)
        {
            testResult = $"[ERROR] ADF Routing Test Error: {ex.Message}";
        }
    }
    
